 <script>
document.addEventListener("DOMContentLoaded", () => {
  const menuButton = document.querySelector(".navbar1_menu-button");
  const menu = document.querySelector(".navbar1_menu");
  const dropdownToggles = document.querySelectorAll(".navbar7_dropdown-toggle");

  // 🔹 Mobile menu toggle
  menuButton?.addEventListener("click", (e) => {
    e.stopPropagation();
    menuButton.classList.toggle("is-active");
    menu?.classList.toggle("is-active");

    document.body.style.overflow =
      menu?.classList.contains("is-active") ? "hidden" : "";
  });

  // 🔹 Dropdown toggle (mobile)
  dropdownToggles.forEach((toggle) => {
    toggle.addEventListener("click", (e) => {
      if (window.innerWidth <= 768) {
        e.preventDefault();
        e.stopPropagation();

        dropdownToggles.forEach((otherToggle) => {
          if (otherToggle !== toggle) {
            const otherList = otherToggle.nextElementSibling;
            if (otherList) {
              otherList.classList.remove("is-active");
            }
          }
        });

        const dropdownList = toggle.nextElementSibling;
        if (dropdownList) {
          dropdownList.classList.toggle("is-active");
        }
      }
    });
  });

  // ✅ GLOBAL CLICK FIX (VERY IMPORTANT)
  document.addEventListener("click", (e) => {
    const target = e.target;

    // 🚨 IGNORE chatbot completely
    if (
      target.closest(".chaticon") ||
      target.closest(".chatbox-container") ||
      target.closest('iframe[src*="mcbchatbot"]')
    ) {
      return;
    }

    // Close menu
    if (
      menu?.classList.contains("is-active") &&
      !target.closest(".navbar1_component")
    ) {
      menu.classList.remove("is-active");
      menuButton?.classList.remove("is-active");
      document.body.style.overflow = "";
    }

    // Close dropdowns (mobile)
    if (window.innerWidth <= 768) {
      if (!target.closest(".navbar7_menu-dropdown")) {
        document.querySelectorAll(".navbar7_dropdown-list").forEach((list) => {
          list.classList.remove("is-active");
        });
      }
    }
  });
});
</script>

<script>
window.addEventListener("load", function () {
  setTimeout(function () {

    const chatIcon = document.querySelector(".chaticon");
    const chatBox = document.querySelector(".chatbox-container");

    if (!chatIcon || !chatBox) {
      console.log("❌ Chatbot elements not found");
      return;
    }

    console.log("✅ Chatbot fix applied");

    // 🚨 STOP close event propagation
    chatIcon.addEventListener("click", function (e) {
      e.stopImmediatePropagation();
    });

    chatBox.addEventListener("click", function (e) {
      e.stopImmediatePropagation();
    });

    // 🔥 Prevent MCB auto-close
    const observer = new MutationObserver(() => {
      if (chatBox.classList.contains("hide")) {
        chatBox.classList.remove("hide");
      }
    });

    observer.observe(chatBox, {
      attributes: true,
      attributeFilter: ["class"]
    });

  }, 2500);
});
</script>

<script>
window.addEventListener("load", function () {
  setTimeout(function () {

    const chatIcon = document.querySelector(".chaticon");
    const chatBox = document.querySelector(".chatbox-container");

    if (!chatIcon || !chatBox) {
      console.log("Chatbot not found");
      return;
    }

    console.log("✅ Chatbox control active");

    // 👉 OPEN
    chatIcon.addEventListener("click", function (e) {
      e.stopPropagation();

      chatBox.style.display = "block";
      chatBox.classList.remove("hide");
    });

    // 👉 CLOSE BUTTON (inside chatbot)
    chatBox.addEventListener("click", function (e) {
      const closeBtn = e.target.closest(".close, .chat-close, .mcb-close");

      if (closeBtn) {
        chatBox.style.display = "none";
        chatBox.classList.add("hide");
      }

      e.stopPropagation();
    });

    // 👉 CLICK OUTSIDE → CLOSE
    document.addEventListener("click", function (e) {
      if (
        !e.target.closest(".chatbox-container") &&
        !e.target.closest(".chaticon")
      ) {
        chatBox.style.display = "none";
        chatBox.classList.add("hide");
      }
    });

  }, 2000);
});
</script> 


