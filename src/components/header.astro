      display: block !important;
      width: 100% !important;
      text-align: left !important;
      white-space: normal !important;
    }

    .navbar7_dropdown-list {
      position: static;
      width: 100%;
      box-shadow: none;
      opacity: 1;
      transform: none;
      display: none;
      padding-left: 1rem;
      overflow: hidden;
    }

    .navbar7_menu-dropdown:hover .navbar7_dropdown-list {
      display: none;
    }

    .navbar7_menu-dropdown.active .navbar7_dropdown-list {
      display: block;
    }

    .navbar7_dropdown-link {
      padding: 0.5rem 0 !important;
      font-size: 1rem !important;
      white-space: normal !important;
    }

    .navbar7_dropdown-link-list h4 {
      margin-top: 1rem;
    }

    /* Add overlay when menu is active */
    .navbar1_menu.mobile-menu-active::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.5);
      z-index: -1;
    }

    /* Prevent horizontal scroll */
    body {
      overflow-x: hidden;
      position: relative;
      width: 100%;
    }

    /* Ensure dropdown content doesn't cause overflow */
    .navbar7_dropdown-content {
      width: 100%;
      overflow-x: hidden;
    }

    .navbar7_dropdown-content-left {
      width: 100%;
      flex-wrap: wrap;
    }

    .navbar7_dropdown-link-list {
      width: 100%;
      min-width: 0;
    }
  }

  /* === Inner Container Layout === */
  .navbar7_container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    display: flex;
    justify-content: space-between;
    gap: 2rem;
  }

  /* Each column */
  .navbar7_dropdown-content-left {
    display: flex;
    justify-content: space-between;
    width: 100%;
  }

  .navbar7_dropdown-link-list {
    flex: 1;
