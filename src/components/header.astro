<script>
  // Mobile menu functionality
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const navMenu = document.querySelector('.navbar1_menu');
  const dropdowns = document.querySelectorAll('.navbar7_menu-dropdown');

  mobileMenuButton?.addEventListener('click', () => {
    navMenu?.classList.toggle('mobile-menu-active');
    mobileMenuButton.classList.toggle('is-active');
    // Prevent body scroll when menu is open
    document.body.style.overflow = navMenu?.classList.contains(
      'mobile-menu-active'
    )
      ? 'hidden'
      : '';
  });

  // Handle dropdowns in mobile view
  dropdowns.forEach((dropdown) => {
    const toggle = dropdown.querySelector('.navbar7_dropdown-toggle');
    toggle?.addEventListener('click', (e) => {
      if (window.innerWidth <= 991) {
        e.preventDefault();
        dropdown.classList.toggle('active');
      }
    });
  });

  // Close menu when clicking outside
  document.addEventListener('click', (e) => {
    if (
      navMenu?.classList.contains('mobile-menu-active') &&
      !navMenu.contains(e.target as Node) &&
      !mobileMenuButton?.contains(e.target as Node)
    ) {
      navMenu.classList.remove('mobile-menu-active');
      mobileMenuButton?.classList.remove('is-active');
      document.body.style.overflow = '';
    }
  });

  // Prevent horizontal scroll
  document.body.style.overflowX = 'hidden';
</script>

<style>
  .navbar7_dropdown-list {
    position: absolute;
    top: 90%;
    left: 0;
    width: 100vw;
    background-color: #fff;
    z-index: 9999;
    display: none;
    opacity: 0;
