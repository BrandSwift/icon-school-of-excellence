  }

  .navbar7_dropdown-link-list h4 {
    font-size: 1rem;
    font-weight: 600;
    color: #e31e26;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid #ddd;
    padding-bottom: 0.3rem;
