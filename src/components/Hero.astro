                <img
                    src="https://ik.imagekit.io/brandswift/isoe/assets/images/facilities/language-laboratory.webp?updatedAt=1745912108085"
                    class="carousel-image"
                    loading="lazy"
                />
                <img
                    src="https://ik.imagekit.io/brandswift/isoe/assets/images/home/slider-4.webp?updatedAt=1745912100292"
                    class="carousel-image"
                    loading="lazy"
                />
                <img
                    src="https://ik.imagekit.io/brandswift/isoe/assets/images/academics/skate.webp?updatedAt=1745912243078"
                    class="carousel-image"
                    loading="lazy"
                />
                <img
                    src="https://ik.imagekit.io/brandswift/isoe/assets/images/home/slider-6.webp?updatedAt=1745912100302"
                    class="carousel-image"
                    loading="lazy"
                />
                <img
