<header class="section_home_hero-header">
    <div class="padding-global-slider">
        <div class="container-large">
            <div class="home_hero-header_component">
                <div class="padding-section-large">
                    <div class="home_hero-header_content-wrapper">
                        <!-- Left Content -->
                        <div class="home_hero-header_content-left">
                            <div class="slider">
                                <div class="w-slide">
                                    <h1
                                        id="changing-text"
                                        class="text-color-white changing-text hero-text-centred"
                                    >
                                        Creating <br />Role Models
                                    </h1>
                                </div>
                            </div>
                        </div>

                        <!-- Right Content -->
                        <div class="home_hero-header_content-right">
                            <div class="text-block">
                                <p class="text-size-medium text-color-white">
                                    ICON School of Excellence comprises of a
                                    dedicated team that is passionately
                                    committed to enhancing the quality of
                                    education in Bangalore. This founding group
                                    is composed of professionals from a rich
                                    tapestry of fields, including medicine,
                                    management, academia, and psychology. Each
                                    member brings unique insights and
                                    experiences, fostering a collaborative
                                    spirit that enriches the learning
                                    environment.
                                </p>
                                <p class="text-size-medium text-color-white">
                                    Together, we create an inspiring atmosphere
                                    where creativity and critical thinking
                                    flourish. This diverse team understands the
                                    complexities of education and the importance
                                    of development, ensuring that every child is
                                    nurtured academically, socially, and
                                    emotionally.
                                </p>
                            </div>

                            <div class="button-group">
                                <a href="/admissions" class="button w-button"
                                    >Admissions</a
                                >
                                <a
                                    href="/about"
                                    class="button is-secondary w-button"
                                    >About ICON</a
                                >
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Video Background -->
    <div class="home_hero-header_background-image-wrapper">
        <div class="image-overlay-layer"></div>
        <div class="carousel-wrapper">
            <div class="home-video">
                <div class="responsive-iframe-wrapper">
                    <iframe
                        src="https://www.youtube.com/embed/jBu9KLtOI8U?autoplay=1&mute=1&loop=1&playlist=jBu9KLtOI8U&controls=0&rel=0&playsinline=1"
                        title="YouTube video player"
                        frameborder="0"
                        allow="autoplay; encrypted-media; fullscreen"
                        allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>
</header>

<style>
    .section_home_hero-header {
        position: relative;
        width: 100%;
        height: 100vh;
        overflow: hidden;
    }

    /* Layout */
    .home_hero-header_content-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 2;
        position: relative;
        height: 100%;
    }

    .home_hero-header_content-left,
    .home_hero-header_content-right {
        flex: 1;
        padding: 20px;
    }

    .hero-text-centred {
        font-size: 3rem;
        font-weight: bold;
        margin: 0;
    }

    .text-color-white {
        color: #fff;
    }

    .text-size-medium {
        font-size: 1.1rem;
        line-height: 1.6;
    }

    /* Right content fix */
    .home_hero-header_content-right {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 20px;
    }

    .home_hero-header_content-right .text-block {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    /* Buttons */
    .button-group {
        display: flex;
        gap: 10px;
        margin-top: 10px;
    }

    .button {
        background: #e21d24;
        color: #fff;
        padding: 10px 20px;
        border-radius: 4px;
        text-decoration: none;
        font-weight: bold;
    }

    .button.is-secondary {
        background: transparent;
        border: 2px solid #fff;
    }

    /* Video full cover */
    .home-video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        overflow: hidden;
    }

    .responsive-iframe-wrapper {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
    }

    .responsive-iframe-wrapper iframe {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 100vw;
        height: 56.25vw; /* 16:9 ratio */
        min-height: 100%;
        min-width: 177.77vh; /* 16:9 ratio */
        transform: translate(-50%, -50%);
    }

    /* Overlay */
    .image-overlay-layer {
        position: absolute;
        inset: 0;
        background-color: rgba(0, 0, 0, 0.4);
        z-index: 1;
    }

    /* Mobile styles */
    @media (max-width: 768px) {
        .home_hero-header_content-wrapper {
            flex-direction: column;
            justify-content: center;
            text-align: center;
            padding: 20px;
        }

        .home_hero-header_content-left,
        .home_hero-header_content-right {
            padding: 10px;
        }

        .hero-text-centred {
            font-size: 2rem;
        }

        .text-size-medium {
            font-size: 1rem;
            line-height: 1.4;
            display: none;
        }

        .home_hero-header_content-right {
            align-items: center;
        }

        .home_hero-header_content-right .text-block {
            max-width: 100%;
        }

        .button-group {
            justify-content: center;
            flex-wrap: wrap;
        }

        .button-group .button {
            margin: 5px;
        }
    }
</style>

<script>
    // Optional heading text changer
    const changingText = document.getElementById("changing-text");
    const textArray = [
        "Creating Role Models",
        "Inspiring Young Minds",
        "Shaping the Future",
    ];
    let textIndex = 0;
    setInterval(() => {
        textIndex = (textIndex + 1) % textArray.length;
        changingText.innerHTML = textArray[textIndex].replace(" ", "<br/>");
    }, 3000);
</script>
