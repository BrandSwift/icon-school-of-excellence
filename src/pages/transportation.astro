---
import Layout from "../layouts/Layout.astro";
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
---

<Layout
    title="School Regulations | Icon School of Excellence, Bangalore"
    description="Learn about the regulations at Icon School of Excellence, designed to create a disciplined and respectful learning environment in Bangalore."
    keywords="school rules Bangalore, Icon School regulations, student guidelines, discipline policies Electronic City, academic code of conduct"
    og_title="School Regulations | Creating a Respectful Learning Environment"
    og_description="At Icon School of Excellence, Bangalore, our regulations ensure a safe, respectful, and disciplined atmosphere for academic and personal growth."
    og_image="https://ik.imagekit.io/brandswift/isoe/assets/images/classes/activity.webp?updatedAt=1745912211907"
    og_url="https://iconschoolofexcellence.com/regulations"
    twitter_description="Understand the regulations at Icon School of Excellence, Bangalore, fostering a respectful and disciplined environment."
    twitter_image="https://ik.imagekit.io/brandswift/isoe/assets/images/classes/activity.webp?updatedAt=1745912211907"
    robots="index, follow"
    canonical="https://iconschoolofexcellence.com/regulations"
>
    <body>
        <Header />

        <main class="main-wrapper">
            <article class="section_academics-thecbs-edge_leadership">
                <div class="padding-global background-color-tertiary">
                    <div class="container-large">
                        <div class="padding-section-medium">
                            <div class="margin-bottom margin-xxlarge">
                                <!-- ------------------ -->

                                <section>
                                    <header>
                                        <h1>Transportation & Bus Routes</h1>
                                        <br />
                                        <p>
                                            Safe, reliable, and convenient
                                            school transport for our students
                                            across Electronic City and nearby
                                            areas.
                                        </p>
                                    </header>
                                </section>

                                <section>
                                    <h2>
                                        Safe, Reliable, and Convenient School
                                        Transport
                                    </h2>
                                    <br />
                                    <p>
                                        At <strong
                                            >ICON School of Excellence</strong
                                        >, we understand that a child’s school
                                        journey is just as important as their
                                        classroom learning. That’s why our
                                        dedicated school transportation service
                                        is designed to provide <strong
                                            >safety, comfort, and punctuality</strong
                                        > for every student. Our modern, GPS-enabled
                                        fleet connects students across Electronic
                                        City and surrounding neighborhoods, ensuring
                                        a stress-free commute for parents and children
                                        alike.
                                    </p>
                                </section>

                                <section>
                                    <h2>
                                        Why Parents Trust Our Transport Facility
                                    </h2>
                                    <br />
                                    <ul>
                                        <li>
                                            <strong>GPS-Enabled Buses</strong> – Real-time
                                            tracking for parents and school administrators.
                                        </li>
                                        <li>
                                            <strong
                                                >Trained & Experienced Drivers</strong
                                            > – All drivers undergo background verification
                                            and regular safety training.
                                        </li>
                                        <li>
                                            <strong
                                                >Lady Attendant on Every Bus</strong
                                            > – To assist younger students and ensure
                                            safe travel.
                                        </li>
                                        <li>
                                            <strong
                                                >RTO-Compliant & Well-Maintained
                                                Fleet</strong
                                            > – Regular maintenance and hygiene checks.
                                        </li>
                                        <li>
                                            <strong
                                                >Safety-First Approach</strong
                                            > – CCTV surveillance, first-aid kits,
                                            and speed governors installed.
                                        </li>
                                        <li>
                                            <strong>Emergency Support</strong> – Dedicated
                                            transport team available during school
                                            hours.
                                        </li>
                                    </ul>
                                </section>

                                <section>
                                    <h2>Our Bus Routes</h2>
                                    <br />
                                    <p>
                                        Below is the current route coverage for
                                        the academic year, designed to reach
                                        students across key areas of Electronic
                                        City and beyond. For detailed pickup
                                        timings, please contact our Transport
                                        Department.
                                    </p>

                                    <table>
                                        <thead>
                                            <tr>
                                                <th>Route No.</th>
                                                <th>Areas Covered</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>Route 1</td>
                                                <td
                                                    >Kotha Road, Hosa Road,
                                                    Ananthanagaram, Fruit
                                                    Market, Huskur Bus Depot,
                                                    Veerasandram,
                                                    Konnapanagrahara, MM School,
                                                    Godrej E-City, Sai Baba
                                                    Temple (Police Layout),
                                                    Sikaripalya, Neo Town, DS
                                                    Max, Gollahalli, Celebrity
                                                    Paradise Layout,
                                                    Chikkathoguru</td
                                                >
                                            </tr>
                                            <tr>
                                                <td>Route 2</td>
                                                <td
                                                    >Margandaahalli,
                                                    Sekraripalya, Neeladri,
                                                    Celebrity Signature, Neo
                                                    Hospital, Green House
                                                    Layout, Bettadasanpura,
                                                    Vedam School (Back Side),
                                                    Ajmeera Neeladri Investment
                                                    Layout, Sikaripalya
                                                    (Starting Point), Omkar
                                                    Layout, Celebrity Paradise
                                                    Layout</td
                                                >
                                            </tr>
                                            <tr>
                                                <td>Route 3</td>
                                                <td
                                                    >Gollahalli, Neo Town Road,
                                                    GM Infinity (Tirupalya
                                                    Road), Timmareddy Layout, SK
                                                    Daisy, PCR Garden Petrol
                                                    Bunk, Himagiri, Durga Bakery</td
                                                >
                                            </tr>
                                        </tbody>
                                    </table>

                                    <!-- <div id="map"></div> -->
                                </section>

                                <section>
                                    <h2>Safety & Compliance Measures</h2>
                                    <ul>
                                        <li>
                                            RTO-compliant buses with speed
                                            control devices.
                                        </li>
                                        <li>CCTV cameras inside buses.</li>
                                        <li>
                                            First-aid kits and trained staff for
                                            medical emergencies.
                                        </li>
                                        <li>
                                            Regular maintenance and cleanliness
                                            checks.
                                        </li>
                                    </ul>
                                </section>

                                <section>
                                    <h2>Transport Department Contact</h2>
                                    <br />
                                    <p>
                                        <strong>Transport Coordinator:</strong> [Name
                                        Placeholder]<br />
                                        <strong>Phone:</strong> [Phone Placeholder]<br
                                        />
                                        <strong>Email:</strong> [Email Placeholder]
                                    </p>
                                </section>

                                <section>
                                    <p>
                                        <em
                                            >Note for Parents: Routes are
                                            planned based on student addresses
                                            and may be updated periodically to
                                            optimize travel time and coverage.</em
                                        >
                                    </p>
                                    <p>
                                        <strong>
                                            Want to know if your area is
                                            covered?</strong
                                        >
                                        <a href="/contact">Contact Us</a> today or
                                        visit our <a href="/admissions"
                                            >Admissions Page</a
                                        > for more details.
                                    </p>
                                </section>

                                <script>
                                    function initMap() {
                                        var map = new google.maps.Map(
                                            document.getElementById("map"),
                                            {
                                                zoom: 12,
                                                center: {
                                                    lat: 12.844,
                                                    lng: 77.671,
                                                },
                                            },
                                        );

                                        var route1Coords = [
                                            { lat: 12.865, lng: 77.671 },
                                            { lat: 12.851, lng: 77.671 },
                                            { lat: 12.844, lng: 77.691 },
                                            { lat: 12.848, lng: 77.7 },
                                            { lat: 12.839, lng: 77.704 },
                                            { lat: 12.832, lng: 77.713 },
                                            { lat: 12.827, lng: 77.717 },
                                            { lat: 12.826, lng: 77.726 },
                                            { lat: 12.822, lng: 77.732 },
                                            { lat: 12.819, lng: 77.739 },
                                            { lat: 12.816, lng: 77.743 },
                                            { lat: 12.812, lng: 77.748 },
                                            { lat: 12.807, lng: 77.753 },
                                            { lat: 12.804, lng: 77.756 },
                                            { lat: 12.8, lng: 77.762 },
                                            { lat: 12.795, lng: 77.768 },
                                        ];
                                        var route1Line =
                                            new google.maps.Polyline({
                                                path: route1Coords,
                                                geodesic: true,
                                                strokeColor: "#1a4c8f",
                                                strokeOpacity: 1.0,
                                                strokeWeight: 4,
                                            });
                                        route1Line.setMap(map);

                                        var route2Coords = [
                                            { lat: 12.853, lng: 77.652 },
                                            { lat: 12.84, lng: 77.655 },
                                            { lat: 12.812, lng: 77.748 },
                                            { lat: 12.8, lng: 77.762 },
                                            { lat: 12.818, lng: 77.74 },
                                            { lat: 12.82, lng: 77.734 },
                                            { lat: 12.824, lng: 77.73 },
                                            { lat: 12.828, lng: 77.725 },
                                            { lat: 12.832, lng: 77.72 },
                                            { lat: 12.816, lng: 77.743 },
                                            { lat: 12.81, lng: 77.75 },
                                            { lat: 12.8, lng: 77.762 },
                                        ];
                                        var route2Line =
                                            new google.maps.Polyline({
                                                path: route2Coords,
                                                geodesic: true,
                                                strokeColor: "#e53935",
                                                strokeOpacity: 1.0,
                                                strokeWeight: 4,
                                            });
                                        route2Line.setMap(map);

                                        var route3Coords = [
                                            { lat: 12.804, lng: 77.756 },
                                            { lat: 12.812, lng: 77.748 },
                                            { lat: 12.8, lng: 77.77 },
                                            { lat: 12.805, lng: 77.774 },
                                            { lat: 12.808, lng: 77.778 },
                                            { lat: 12.812, lng: 77.78 },
                                            { lat: 12.816, lng: 77.784 },
                                            { lat: 12.82, lng: 77.788 },
                                        ];
                                        var route3Line =
                                            new google.maps.Polyline({
                                                path: route3Coords,
                                                geodesic: true,
                                                strokeColor: "#43a047",
                                                strokeOpacity: 1.0,
                                                strokeWeight: 4,
                                            });
                                        route3Line.setMap(map);

                                        function placeMarkers(coords, map) {
                                            coords.forEach(function (location) {
                                                new google.maps.Marker({
                                                    position: location,
                                                    map: map,
                                                });
                                            });
                                        }
                                        placeMarkers(route1Coords, map);
                                        placeMarkers(route2Coords, map);
                                        placeMarkers(route3Coords, map);
                                    }
                                </script>
                                <script
                                    async
                                    defer
                                    src="https://maps.googleapis.com/maps/api/js?key=YOUR_API_KEY&callback=initMap"
                                ></script>

                                <style>
                                    section {
                                        padding: 20px;
                                        max-width: 1100px;
                                        margin: auto;
                                    }
                                    h1,
                                    h2,
                                    h3 {
                                        color: #e31e26;
                                        font-size: 35px;
                                    }
                                    ul {
                                        list-style-type: disc;
                                        padding-left: 20px;
                                    }
                                    table {
                                        width: 100%;
                                        border-collapse: collapse;
                                        margin-top: 15px;
                                        font-size: 15px;
                                    }
                                    table th,
                                    table td {
                                        border: 1px solid #ccc;
                                        padding: 10px;
                                        text-align: left;
                                        vertical-align: top;
                                    }
                                    table th {
                                        background-color: #051831;
                                        color: #fff;
                                        font-weight: bold;
                                    }
                                    table tr:nth-child(1) {
                                        background-color: #f9f9f9;
                                    }
                                    table tr:nth-child(2) {
                                        background-color: #f9f9f9;
                                    }
                                    table tr:nth-child(3) {
                                        background-color: #f9f9f9;
                                    }
                                    #map {
                                        height: 450px;
                                        width: 100%;
                                        margin-top: 20px;
                                        border: 2px solid #ccc;
                                    }
                                    @media (max-width: 768px) {
                                        table,
                                        thead,
                                        tbody,
                                        th,
                                        td,
                                        tr {
                                            display: block;
                                            width: 100%;
                                        }
                                        table tr {
                                            margin-bottom: 15px;
                                            border-bottom: 2px solid #ddd;
                                        }
                                        table td,
                                        table th {
                                            text-align: left;
                                            padding: 8px;
                                        }
                                        table th {
                                            background-color: #1a4c8f;
                                            color: white;
                                        }
                                    }
                                </style>
                            </div>
                        </div>
                    </div>
                </div>
            </article>
        </main>
    </body>

    <Footer />
</Layout>

<style></style>
