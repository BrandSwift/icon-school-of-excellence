    alt: "icon-school-of-excellence-field-trip-1",
  },
  {
    src: "https://ik.imagekit.io/brandswift/isoe/assets/images/events/field%20trip/Icon%20School%20of%20Excellence1.webp?updatedAt=1745912180856",
    alt: "icon-school-of-excellence-field-trip-2",
  },
  {
    src: "https://ik.imagekit.io/brandswift/isoe/assets/images/events/field%20trip/Icon%20School%20of%20Excellence2.webp?updatedAt=1745912180993",
    alt: "icon-school-of-excellence-field-trip-3",
  },
  {
    src: "https://ik.imagekit.io/brandswift/isoe/assets/images/events/field%20trip/Icon%20School%20of%20Excellence3.webp?updatedAt=1745912181630",
    alt: "icon-school-of-excellence-field-trip-4",
  },
  {
    src: "https://ik.imagekit.io/brandswift/isoe/assets/images/events/field%20trip/Icon%20School%20of%20Excellence4.webp?updatedAt=1745912182019",
    alt: "icon-school-of-excellence-field-trip-5",
  },
  {
    src: "https://ik.imagekit.io/brandswift/isoe/assets/images/events/field%20trip/Icon%20School%20of%20Excellence5.webp?updatedAt=1745912186572",
