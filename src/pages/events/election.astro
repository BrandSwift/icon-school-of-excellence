---
import Layout from "../../layouts/Layout.astro";
import EventsList from "../../components/events-list.astro";

const images = [
  {
    src: "https://ik.imagekit.io/brandswift/isoe/assets/images/events/election/icon%20school%20of%20excellence%20-%20election1.webp?updatedAt=1745912196654",
    alt: "icon-school-of-excellence-election-1",
  },
  {
    src: "https://ik.imagekit.io/brandswift/isoe/assets/images/events/election/icon%20school%20of%20excellence%20-%20election3.webp?updatedAt=1745912196867",
    alt: "icon-school-of-excellence-election-2",
  },
  {
    src: "https://ik.imagekit.io/brandswift/isoe/assets/images/events/election/icon%20school%20of%20excellence.webp?updatedAt=1745912197561",
    alt: "icon-school-of-excellence-election-3",
  },
  {
    src: "https://ik.imagekit.io/brandswift/isoe/assets/images/events/election/icon%20school%20of%20excellence%20-%20election4.webp?updatedAt=1745912197500",
    alt: "icon-school-of-excellence-election-4",
  },
];
---

<Layout
  title="Student Council Election | Icon School of Excellence"
  description="Witness leadership in action at Icon School of Excellence during the Student Council Elections in Bangalore"
  keywords="Student elections Bangalore, school leadership programs, Icon School council, student governance"
  robots="ndex, follow"
  canonical="https://iconschoolofexcellence.com/events/election"
>
  <EventsList
    event_title="Student Council Election"
    event_sub_title="Explore the latest photos from ourStudent Council Election at ISOE"
    paragraph=` The School Election at Icon School of Excellence
                                was an event that encouraged leadership and
                                civic engagement among students. Candidates from
                                different grades campaigned for student council
                                positions, presenting their ideas for improving
                                school life through speeches. Voting was
                                conducted in a structured way, teaching students
                                about democracy and the value of participation.
                                The election ended with a lively ceremony
                                celebrating the new representatives, fostering a
                                sense of responsibility and community
                                involvement among students`
    images={images}
  />
</Layout>
