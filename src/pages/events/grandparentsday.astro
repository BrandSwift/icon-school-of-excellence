  },
  {
    src: "https://ik.imagekit.io/brandswift/isoe/assets/images/events/grand%20parents/icon%20school%20of%20excellence%20-%20GPDC3.webp?updatedAt=1745912153999",
    alt: "icon-school-of-excellence-grand-parents-day-2",
  },
  {
    src: "https://ik.imagekit.io/brandswift/isoe/assets/images/events/grand%20parents/icon%20school%20of%20excellence%20-%20GPDC4.webp?updatedAt=1745912154640",
    alt: "icon-school-of-excellence-grand-parents-day-3",
  },
  {
    src: "https://ik.imagekit.io/brandswift/isoe/assets/images/events/grand%20parents/icon%20school%20of%20excellence%20-%20GPDC5.webp?updatedAt=1745912160089",
