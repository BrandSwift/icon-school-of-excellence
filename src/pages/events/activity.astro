  },
  {
    src: "https://ik.imagekit.io/brandswift/isoe/assets/images/events/activity/icon%20school%20of%20excellence%20activity3.webp?updatedAt=1745912205151",
    alt: "icon-school-of-excellence-hands-on-activity-2",
  },
  {
    src: "https://ik.imagekit.io/brandswift/isoe/assets/images/events/activity/icon%20school%20of%20excellence%20activity4.webp?updatedAt=1745912206307",
    alt: "icon-school-of-excellence-hands-on-activity-3",
  },
  {
    src: "https://ik.imagekit.io/brandswift/isoe/assets/images/events/activity/icon%20school%20of%20excellence%20activity5.webp?updatedAt=1745912207053",
    alt: "icon-school-of-excellence-hands-on-activity-4",
  },
  {
    src: "https://ik.imagekit.io/brandswift/isoe/assets/images/events/activity/icon%20school%20of%20excellence%20activity6.webp?updatedAt=1745912207253",
