    event_title="Sri Krishna Janmashtami"
    event_sub_title="Explore the latest photos from our Sri Krishna Janmashtami celebration at ISOE"
    paragraph=`The Krishna Janmashtami celebration at Icon
                                School of Excellence was a vibrant event where
                                children organized an engaging assembly.
                                Kindergarten students dressed up as little
                                Krishna and Radha, adding to the festive spirit.
                                The assembly featured songs, dances, and
                                reenactments, showcasing the significance of the
                                occasion and fostering joy and community among
                                students and staff`
    images={images}
  />
</Layout>
