    alt: "icon-school-of-excellence-blue-day-2",
  },
  {
    src: "https://ik.imagekit.io/brandswift/isoe/assets/images/events/blue%20day/Icon%20school%20of%20excellence%20blue3.webp?updatedAt=1745912202516",
