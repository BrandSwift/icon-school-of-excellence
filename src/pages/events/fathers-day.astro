  },
  {
    src: "https://ik.imagekit.io/brandswift/isoe/assets/images/events/fathers-day/icon%20school%20of%20excellence%20-%20fathers-day2.webp?updatedAt=1745912186804",
    alt: "icon-school-of-excellence-father-day-2",
  },
  {
    src: "https://ik.imagekit.io/brandswift/isoe/assets/images/events/fathers-day/icon%20school%20of%20excellence%20-%20fathers-day5.webp?updatedAt=1745912188484",
    alt: "icon-school-of-excellence-father-day-3",
  },
  {
