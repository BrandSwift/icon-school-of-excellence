---
import Layout from '../../layouts/Layout.astro';
import EventsList from '../../components/events-list.astro';

const images = [
  {
    src: '/assets/images/events/sports-day/sports-day-2.webp',
    alt: 'icon-school-of-excellence-kannada-rajyotsava-1',
  },
  {
    src: '/assets/images/events/sports-day/sports-day-3.webp',
    alt: 'icon-school-of-excellence-kannada-rajyotsava-2',
  },
  {
    src: '/assets/images/events/sports-day/sports-day-4.webp',
    alt: 'icon-school-of-excellence-kannada-rajyotsava-3',
  },
  {
    src: '/assets/images/events/sports-day/sports-day-1.webp',
    alt: 'icon-school-of-excellence-kannada-rajyotsava-4',
  },
  {
    src: '/assets/images/events/sports-day/sports-day-5.webp',
    alt: 'icon-school-of-excellence-kannada-rajyotsava-5',
