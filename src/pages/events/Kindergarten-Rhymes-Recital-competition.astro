        alt: "icon-school-of-excellence-Kindergarten Rhymes Recital competition-1",
    },
    {
        src: "https://ik.imagekit.io/brandswift/isoe/assets/images/events/Kindergarten%20Rhymes%20Recital%20competition/icon-3%20(1).jpg?updatedAt=1751459183473",
        alt: "icon-school-of-excellence-Kindergarten Rhymes Recital competition-2",
    },
    {
        src: "https://ik.imagekit.io/brandswift/isoe/assets/images/events/Kindergarten%20Rhymes%20Recital%20competition/icon-4%20(1).jpg?updatedAt=1751459183537",
        alt: "icon-school-of-excellence-Kindergarten Rhymes Recital competition-3",
    },
    {
        src: "https://ik.imagekit.io/brandswift/isoe/assets/images/events/Kindergarten%20Rhymes%20Recital%20competition/icon-5%20(1).jpg?updatedAt=1751459183553",
