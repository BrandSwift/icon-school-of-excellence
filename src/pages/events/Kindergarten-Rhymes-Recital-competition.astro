---

<Layout
    title="International Yoga Day | Icon School of Excellence"
    description="Icon School of Excellence celebrates International Yoga Day with sessions to promote wellness and mindfulness among students in Bangalore"
    keywords="Yoga Day Bangalore, school wellness programs, yoga sessions, Icon School activities"
    robots="index, follow"
    canonical="https://iconschoolofexcellence.com/events/Kindergarten-Rhymes-Recital-competition"
>
    <EventsList
        event_title="Kindergarten Rhymes Recital competition"
        event_sub_title="Explore the latest photos from our Kindergarten Rhymes Recital competition at ISOE"
        images={images}
    />
</Layout>
