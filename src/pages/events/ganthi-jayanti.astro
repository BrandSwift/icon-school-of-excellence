import EventsList from '../../components/events-list.astro';

const images = [
  {
    src: '/assets/images/events/gandhi jayanti/icon school of excellence gandhi jayanti4.webp',
    alt: 'icon-school-of-excellence-ganthi-jayandhi-1',
  },
  {
    src: '/assets/images/events/gandhi jayanti/icon school of excellence gandhi jayanti.webp',
    alt: 'icon-school-of-excellence-ganthi-jayandhi-2',
  },
  {
    src: '/assets/images/events/gandhi jayanti/icon school of excellence gandhi jayanti1.webp',
    alt: 'icon-school-of-excellence-ganthi-jayandhi-3',
  },
  {
    src: '/assets/images/events/gandhi jayanti/icon school of excellence gandhi jayanti2.webp',
    alt: 'icon-school-of-excellence-ganthi-jayandhi-4',
  },
  {
    src: '/assets/images/events/gandhi jayanti/icon school of excellence gandhi jayanti3.webp',
    alt: 'icon-school-of-excellence-ganthi-jayandhi-5',
  },
  {
    src: '/assets/images/events/gandhi jayanti/icon school of excellence gandhi jayanti5.webp',
