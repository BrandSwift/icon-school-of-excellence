  <style>
    .padding-section-large {
      padding: 30px 30px;
    }
    .text-size-regular span {
      color: black;
      font-weight: bold;
      font-size: 15px;
    }
    .blog-list-card {
      display: flex;
      flex-direction: column;
      border: 1px solid #ddd;
      border-radius: 8px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      overflow: hidden;
      background-color: #fff;
      transition:
        transform 0.3s,
        box-shadow 0.3s;
    }

    .blog-list-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 6px 10px rgba(0, 0, 0, 0.15);
    }

    .blog_featured-blog-list-header_image-wrapper {
      width: 100%;
      height: 200px;
      overflow: hidden;
    }

    .blog_featured-blog-list-header_image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .text-color-orange {
      color: #ff8c00;
      font-size: 1rem;
      font-weight: bold;
      margin: 16px;
    }

    .blog_featured-blog-list-header_title-link {
      margin: 16px;
      text-decoration: none;
      color: #333;
      font-size: 1.25rem;
      font-weight: bold;
    }

    .blog_featured-blog-list-header_title-link h3 {
      margin: 0;
    }

    .text-size-regular {
      margin: 16px;
      font-size: 1rem;
      color: #666;
    }

    .blog_featured-blog-list-header_author-wrapper {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px;
      font-size: 0.875rem;
      color: #999;
    }

    .blog_featured-blog-list-header_author-wrapper .text-weight-semibold {
      font-weight: bold;
    }
  </style>
</Layout>
