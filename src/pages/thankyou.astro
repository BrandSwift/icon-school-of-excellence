---
import Header from "../components/header.astro";
import HeaderThank from "../components/header_thank.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Thank You | ICON School of Excellence"
    description="Thank you for contacting ICON School of Excellence. Our admissions team will contact you shortly."
    keywords="ICON School admissions, enquiry form, thank you page"
    og_title="Thank You | ICON School of Excellence"
    og_description="Thank you for your enquiry. Our admissions team will reach out soon."
    og_image="/logo.webp"
    og_url="https://iconschoolofexcellence.com/thankyou"
    twitter_description="Thank you for contacting ICON School of Excellence."
    twitter_image="/logo.webp"
    robots="noindex,nofollow"
    canonical="https://iconschoolofexcellence.com/thankyou"
>
    <body>
        <div class="page-wrapper">
            <HeaderThank />
            <main class="main-wrapper">
                <div class="container-thank">
                    <!-- Left Blog Title -->
                    <div class="blog-left">
                        <img
                            src="https://ik.imagekit.io/brandswift/isoe/assets/images/blog/icse-schools-in-bangalore.webp?updatedAt=1745912227384"
                            loading="lazy"
                            decoding="async"
                            width="500"
                            height="300"
                            alt="How ICSE Schools in Bangalore Are Shaping the Future of Education"
                            style="border-radius:10px"
                        />
                        <h5>
                            <a
                                href="/blogs/How-ICSE-Schools-in-Bangalore-Are-Shaping-the-Future-of-Education"
                                style="text-decoration: none;"
                            >
                                How ICSE Schools in Bangalore Are Shaping the
                                Future of Education</a
                            >
                        </h5>
                    </div>

                    <!-- Thank You Content (Centered) -->
                    <div class="thank-content">
                        <img
                            src="/assets/images/icons/send-mail.png"
                            width="150"
                            height="150"
                            fetchpriority="high"
                            alt="Thank You Submission"
                        />
                        <p
                            style="font-size: 35px; font-weight: 600; font-family: Poppins, sans-serif; padding-bottom: 20px; color: #e31e26;"
                        >
                            Thank you for submitting your details!
                        </p>
                        <p
                            style="font-size: 22px; font-family: Poppins, sans-serif;"
                        >
                            We will review your submission shortly!
                        </p>
                        <p>
                            <strong>Name :</strong>
                            <span id="thank-name"></span>
                        </p>

                        <p>
                            <strong>Email :</strong>
                            <span id="thank-email"></span>
                        </p>
                        <p>
                            <strong>Phone:</strong>
                            <span id="thank-phone"></span>
                        </p>
                        <p>
                            <strong>Message:</strong>
                            <span id="thank-message"></span>
                        </p>

                        <div class="margin-top margin-medium">
                            <div class="button-group">
                                <a href="/" class="button is-secondary w-button"
                                    >Go Home</a
                                >
                            </div>
                        </div>
                    </div>

                    <!-- Right Blog Title -->
                    <div class="blog-right">
                        <img
                            src="https://ik.imagekit.io/brandswift/isoe/assets/images/blog/icon-school-of-excellence-why-icse.webp?updatedAt=1745912226510"
                            loading="lazy"
                            decoding="async"
                            width="500"
                            height="300"
                            alt="How ICSE Schools in Bangalore Are Shaping the Future of Education"
                            style="border-radius:10px"
                        />
                        <h5>
                            <a
                                href="/blogs/why-icse"
                                style="text-decoration: none;"
                                >Top Reasons Why ICSE Schools in Bangalore Offer
                                a Superior Education Experience</a
                            >
                        </h5>
                    </div>
                </div>
            </main>
        </div>
    </body>

