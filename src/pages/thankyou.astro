    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const storedData = sessionStorage.getItem("formData");

            if (!storedData) {
                window.location.replace("/");
                return;
            }

            const formData = JSON.parse(storedData);

            document.getElementById("thank-name").textContent =
                `${formData.firstname || ""} ${formData.lastname || ""}`;

            document.getElementById("thank-email").textContent =
                formData.email || "";

            document.getElementById("thank-phone").textContent =
                formData.phonenumber || "";

            document.getElementById("thank-message").textContent =
                formData.message || "";

            sessionStorage.removeItem("formData");
        });
    </script>

    <style>
        .container-thank {
            display: grid;
            grid-template-columns: 1fr 2fr 1fr;
            align-items: center;
            text-align: center;
        }
        .blog-left {
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
            border-radius: 10px;
            overflow: hidden;
        }
        .thank-content {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 50vh;
            padding: 10px;
        }
        .thank-content p {
            text-align: center;
        }
        .blog-right {
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
            border-radius: 10px;
            overflow: hidden;
        }
        @media screen and (max-width: 990px) {
            .container-thank {
                display: flex;
                flex-direction: column;
                gap: 20px;
                padding: 20px;
                margin-top: 20px;
            }

            .blog-left,
            .blog-right {
                display: none;
            }

            .thank-content {
                min-height: auto;
                padding: 20px;
            }
        }
    </style>
</Layout>
