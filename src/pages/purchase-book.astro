---
import Layout from "../layouts/Layout.astro";
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
---

<Layout
    title="Events at Icon School of Excellence | Celebrating Learning and Growth"
    description="Stay updated on the exciting events at Icon School of Excellence, Bangalore. From academic achievements to cultural celebrations, there's always something happening."
    keywords="school events Bangalore, celebrations at Icon School, cultural programs Electronic City, academic achievements, student engagement"
    og_title="School Events | Icon School of Excellence, Bangalore"
    og_description="Join us in celebrating learning and achievements through events at Icon School of Excellence, Bangalore. Enriching experiences for students and parents alike."
    og_image="https://ik.imagekit.io/brandswift/isoe/assets/images/events/exhibition/science.webp?updatedAt=1745912192097"
    og_url="https://iconschoolofexcellence.com/events"
    twitter_description="Learn about the engaging events at Icon School of Excellence in Bangalore, from cultural programs to academic milestones."
    twitter_image="https://ik.imagekit.io/brandswift/isoe/assets/images/events/exhibition/science.webp?updatedAt=1745912192097"
    robots="index, follow"
    canonical="https://iconschoolofexcellence.com/events"
>
    <!-- <body class="body"> -->
    <div class="page-wrapper">
        <Header />

        <main class="main-wrapper">
            <header
                id="blog-header-5"
                class="section_blog_featured-blog-list-header"
            >
                <div class="padding-global">
                    <div class="container-large">
                        <div class="padding-section-large">
                            <!-- ---------- -->

                            <section class="books-page">
                                <!-- HERO -->
                                <div class="hero">
                                    <div class="hero-inner">
                                        <div class="hero-text">
                                            <h1>Purchase School Books</h1>
                                            <p>
                                                Prescribed textbooks for
                                                Preschool to Grade 12
                                            </p>

                                            <a
                                                href="https://slnbooks.com/register"
                                                class="btn-main"
                                                target="_blank">PURCHASE NOW</a
                                            >

                                            <small
                                                >You will be redirected to the
                                                authorised book vendor website.</small
                                            >
                                        </div>

                                        <div class="hero-img">
                                            <img
                                                src="/assets/images/book.png"
                                                alt=""
                                            />
                                        </div>
                                    </div>
                                </div>

                                <!-- INFO -->

                                <div class="section">
                                    <h3>Important Information</h3>
                                    <div class="info-box">
                                        ICON School of Excellence provides
                                        access to authorised book vendors. All
                                        grade wise book lists and purchases are
                                        available on the vendor website after
                                        redirection.
                                    </div>
                                </div>

                                <!-- GRADES -->

                                <div class="section">
                                    <h3>Select Student Grade</h3>

                                    <div class="grade-grid">
                                        <div class="grade-card">
                                            <h6>Preschool</h6><a
                                                href="https://slnbooks.com/register"
                                                target="_blank">Purchase Now</a
                                            >
                                        </div>
                                        <div class="grade-card">
                                            <h6>Lower Kindergarten</h6><a
                                                href="https://slnbooks.com/register"
                                                target="_blank">Purchase Now</a
                                            >
                                        </div>
                                        <div class="grade-card">
                                            <h6>Upper Kindergarten</h6><a
                                                href="https://slnbooks.com/register"
                                                target="_blank">Purchase Now</a
                                            >
                                        </div>
                                        <div class="grade-card">
                                            <h6>Grade 1</h6><a
                                                href="https://slnbooks.com/register"
                                                target="_blank">Purchase Now</a
                                            >
                                        </div>

                                        <div class="grade-card">
                                            <h6>Grade 2</h6><a
                                                href="https://slnbooks.com/register"
                                                target="_blank">Purchase Now</a
                                            >
                                        </div>
                                        <div class="grade-card">
                                            <h6>Grade 3</h6><a
                                                href="https://slnbooks.com/register"
                                                target="_blank">Purchase Now</a
                                            >
                                        </div>
                                        <div class="grade-card">
                                            <h6>Grade 4</h6><a
                                                href="https://slnbooks.com/register"
                                                target="_blank">Purchase Now</a
                                            >
                                        </div>
                                        <div class="grade-card">
                                            <h6>Grade 5</h6><a
                                                href="https://slnbooks.com/register"
                                                target="_blank">Purchase Now</a
                                            >
                                        </div>
                                    </div>
                                </div>

                                <!-- STEPS -->

                                <div class="section steps">
                                    <h3>How the Purchase Works</h3>

                                    <ul>
                                        <li>
                                            <span>1</span>
                                            Click Purchase Now
                                        </li>
                                        <li>
                                            <span>2</span>Redirect to vendor
                                            website
                                        </li>
                                        <li>
                                            <span>3</span>Create Account
                                        </li>
                                        <li>
                                            <span>4</span>View the book list
                                        </li>
                                        <li>
                                            <span>5</span>Complete payment with
                                            vendor
                                        </li>
                                    </ul>
                                </div>

                                <!-- DISCLAIMER -->

                                <div class="section disclaimer">
                                    <h3>Disclaimer</h3>
                                    <p>
                                        All payments are made directly to third
                                        party book vendors.
                                    </p>
                                    <p>
                                        ICON School of Excellence does not
                                        collect or process payments.
                                    </p>
                                    <p>
                                        The school is not responsible for
                                        transactions, delivery or refunds.
                                    </p>
                                </div>

                                <!-- FINAL CTA -->

                                <div class="section final">
                                    <h3>Proceed to Book Purchase</h3>
                                    <a
                                        href="https://slnbooks.com/register"
                                        class="btn-main"
                                        target="_blank">PURCHASE NOW</a
                                    >
                                    <!-- <p>
                                        Please ensure grade is selected before
                                        proceeding.
                                    </p> -->
                                </div>
                            </section>
                        </div>
                    </div>
                </div>
            </header>
        </main>
    </div>
    <Footer />

    <style>
        .books-page {
            width: 100%;
            max-width: 1200px;
            margin: auto;
            padding: 0 20px;
            font-family:
                Segoe UI,
                Arial;
            color: #1c1c1c;
        }

        /* HERO */

        .hero {
            background: #f6f8fb;
            padding: 70px 20px;
        }

        .hero-inner {
            display: grid;
            grid-template-columns: 1fr 1fr;
            align-items: center;
            gap: 60px;
            max-width: 1100px;
            margin: auto;
        }

        .hero-text {
            max-width: 480px;
        }

        .hero-text h1 {
            font-size: 38px;
            color: #00173f;
            margin-bottom: 10px;
            letter-spacing: 0.4px;
        }

        .hero-text p {
            margin-bottom: 20px;
            line-height: 1.6;
        }

        .hero-text small {
            display: block;
            margin-top: 12px;
            color: #666;
        }

        .hero-img {
            display: flex;
            justify-content: flex-end;
        }

        .hero-img img {
            width: 100%;
            max-width: 300px;
            object-fit: contain;
        }

        /* BUTTON */

        .btn-main {
            background: linear-gradient(180deg, #e31e26, #e31e26);
            color: #fff;
            padding: 14px 45px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
            display: inline-block;
            box-shadow: 0 6px 14px rgba(0, 0, 0, 0.15);
            transition: 0.5s;
        }

        .btn-main:hover {
            background: #031832;
            transform: translateY(-3px);
        }

        /* SECTIONS */

        .section {
            padding: 60px 0px;
            text-align: center;
            border-bottom: 1px solid #e5e5e5;
        }

        .section h3 {
            color: #031832;
            margin-bottom: 25px;
            font-size: 24px;
            letter-spacing: 0.4px;
        }

        /* INFO */

        .info {
            background: #f1f4f9;
        }
        .info-box {
            font-size: 25px;
            font-weight: bolder;
        }

        /* GRADES */

        .grade-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
            max-width: 1000px;
            margin: auto;
        }

        .grade-card {
            background: white;
            padding: 25px 20px;
            border-radius: 12px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            transition: 0.5s;
        }

        .grade-card:hover {
            transform: translateY(-6px);
        }

        .grade-card h4 {
            margin: 0;
            text-align: center;
            letter-spacing: 0.4px;
        }

        .grade-card a {
            background: linear-gradient(180deg, #e31e26, #e31e26);
            color: white;
            padding: 10px 32px;
            border-radius: 4px;
            text-decoration: none;
            font-weight: 600;
            transition: 0.3s;
        }

        .grade-card a:hover {
            background: #031832;
            transform: translateY(-3px);
        }

        /* STEPS */

        .steps ul {
            list-style: none;
            max-width: 900px;
            margin: auto;
            padding: 0;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .steps li {
            display: flex;
            gap: 12px;
            align-items: center;
            background: white;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
        }

        .steps span {
            background: #9fb4d9;
            color: white;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }

        /* DISCLAIMER */

        .disclaimer {
            background: #f7f7f7;
            font-size: 14px;
            line-height: 1.6;
        }
        .disclaimer p {
            justify-content: center;
            text-align: center;
            font-size: 20px;
        }

        /* FINAL */

        .final p {
            margin-top: 12px;
            color: #555;
        }

        /* MOBILE */

        @media (max-width: 768px) {
            .hero-inner {
                grid-template-columns: 1fr;
                text-align: center;
            }

            .hero-text {
                margin: auto;
            }

            .hero-img {
                justify-content: center;
                margin-top: 30px;
            }

            .grade-grid {
                grid-template-columns: 1fr 1fr;
            }

            .steps ul {
                grid-template-columns: 1fr;
            }

            .info-box {
                font-size: 20px;
                font-weight: 400;
            }
        }

        @media (max-width: 480px) {
            .grade-grid {
                grid-template-columns: 1fr;
            }
        }

        /* ASTRO PADDING FIX */

        .padding-global {
            content: "";
        }

        @media screen and (max-width: 800px) {
            .padding-global {
                padding: 0 30px;
            }
        }

        /* --------- */
        /* .padding-global {
            content: "";
        }
        @media screen and (max-width: 800px) {
            .padding-global {
                padding: 0px 30px;
            }
        }

        .blog_featured-blog-list-header_image-wrapper img {
            object-fit: cover;
        } */

        /* ----------- */
    </style>
    <!-- </body> -->
</Layout>
