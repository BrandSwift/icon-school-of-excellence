            .modal {
              position: fixed;
              width: 100%;
              height: 100%;
              background: rgba(0, 0, 0, 0.5);
              display: flex;
              justify-content: center;
              align-items: center;
              top: 0;
              left: 0;
              z-index: 1000;
              opacity: 0;
              pointer-events: none;
              transition: opacity 0.3s ease;
            }

            .modal-content {
              background: #ffffff;
              padding: 30px;
              border-radius: 12px;
              box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
              position: relative;
              width: 80%;
              max-height: 100vh;
              overflow-y: auto;
              font-family: Arial, sans-serif;
              color: #333;
            }

            .modal-content h3 {
              margin-top: 0;
              font-size: 1.5rem;
              color: #031832;
              text-align: center;
            }

            .modal-content p {
              margin: 10px 0 0;
              line-height: 1.6;
              font-size: 1rem;
            }

            .close-btn {
              position: absolute;
              top: 10px;
              right: 10px;
              background: transparent;
              border: none;
              font-size: 1.5rem;
              color: #e31e26;
              cursor: pointer;
              transition: transform 0.3s ease;
            }

            .close-btn:hover {
              transform: scale(1.2);
            }
            @media (max-width: 768px) {
              .modal-content {
                width: 90%;
                max-width: 90%;
              }
            }

            .modal.active {
              opacity: 1;
              pointer-events: auto;
            }
            .read-more-btn {
              background-color: transparent;
              text-decoration: underline;
            }
          </style>

          <script is:inline>
            document.addEventListener("DOMContentLoaded", function () {
              let currentIndex = 0;
              const slides = document.querySelectorAll(".padding-global");
              const totalSlides = 5;
              let slideInterval;

              const slider = document.getElementById("slider");
              const readMoreButtons =
                document.querySelectorAll(".read-more-btn");

              readMoreButtons.forEach((button) => {
                const parentContainer = button.closest(
                  ".testimonial-container",
                );
                const text = parentContainer.querySelector(
                  ".testimonial-summary",
                ).innerText;
                const maxLength = 100;
                if (text.length <= maxLength) {
                  button.style.display = "none";
                }
              });

              function showSlide(index) {
                currentIndex = (index + totalSlides) % totalSlides;
                slider.style.transform = `translateX(-${currentIndex * 100}%)`;
              }

              function startSliding() {
                slideInterval = setInterval(() => {
                  showSlide(currentIndex + 1);
                }, 3000);
              }

              function stopSliding() {
                clearInterval(slideInterval);
              }

              slider.addEventListener("mouseover", stopSliding);
              slider.addEventListener("mouseout", startSliding);

              window.moveSlide = function (direction) {
                showSlide(currentIndex + direction);
              };

              startSliding();
            });

            function openModal(modalId, event) {
              const modal = document.getElementById(modalId);
              const buttonRect = event.target.getBoundingClientRect();
              const modalContent = modal.querySelector(".modal-content");
              const modalX =
                buttonRect.left +
                buttonRect.width / 2 -
                modalContent.offsetWidth / 2;
              const modalY =
                buttonRect.top +
                buttonRect.height / 2 -
                modalContent.offsetHeight / 2;
              modal.style.position = "absolute";
              modal.style.display = `flex`;
              modal.style.justifyContent = `center`;
              modal.style.alignItems = `center`;
              modal.classList.add("active");
            }

            function closeModal(modalId) {
              const modal = document.getElementById(modalId);
              modal.classList.remove("active");
            }
          </script>
