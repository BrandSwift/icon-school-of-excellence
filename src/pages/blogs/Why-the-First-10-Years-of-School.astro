    .article-content li {
        color: #555d68;
        font-size: 17px;
        line-height: 1.9;
    }

    .article-content strong {
        color: #102653;
    }

    .article-content ul {
        padding-left: 22px;
    }

    .article-content li {
        margin: 7px 0;
    }

    .answer {
        margin: 55px 0;
        padding: 35px 40px;
        border-left: 4px solid #c51f2a;
        background: #f8f4ef;
    }

    .answer h3 {
        margin: 15px 0;
        font-size: 26px;
    }

    .answer p {
        margin: 0;
    }

    .skills {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 25px 0;
    }

    .skills span {
        padding: 10px 15px;
        border: 1px solid #ddd;
        color: #3d4653;
        font-size: 14px;
    }

    .section-heading {
        margin: 100px 0 45px;
        padding-top: 35px;
        border-top: 1px solid #ddd;
    }

    .section-heading h2 {
        margin-top: 18px;
    }

    .number-section {
        display: grid;
        grid-template-columns: 65px 1fr;
        gap: 25px;
        padding: 35px 0;
        border-top: 1px solid #e5e5e5;
    }

    .number-section b {
        color: #c51f2a;
        font-family: Georgia, serif;
        font-size: 28px;
        font-weight: 500;
    }

    .number-section h3 {
        margin: 0 0 15px;
    }

    .number-section p {
        margin: 0 0 12px;
    }

    .article-image {
        margin: 80px 0;
    }

    .article-image img {
        height: 430px;
    }

    figcaption {
        padding-top: 12px;
        color: #888;
        font-size: 12px;
    }

    .table {
        margin: 35px 0;
        border-top: 1px solid #bbb;
    }

    .table > div {
        display: grid;
        grid-template-columns: 35% 65%;
        padding: 17px 0;
        border-bottom: 1px solid #ddd;
        gap: 20px;
    }

    .table span {
        color: #555d68;
        line-height: 1.6;
        font-size: 15px;
    }

    .icon-section {
        margin-top: 90px;
        padding: 55px 50px;
        background: #102653;
    }

    .icon-section h2 {
        color: #fff;
        margin-top: 18px;
    }

    .icon-section p,
    .icon-section li {
        color: #e8ebf1;
    }

    .icon-section ul {
        margin: 25px 0;
    }

    .icon-section > span {
        color: #e43a43;
    }

    .article-end {
        margin-top: 90px;
        padding-top: 30px;
        border-top: 2px solid #102653;
    }

    .article-end span {
        color: #c51f2a;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .article-end p {
        margin-top: 8px;
        color: #102653;
        font-family: Georgia, serif;
        font-size: 22px;
    }

    @media (max-width: 800px) {
        .article-hero {
            padding: 55px 0 40px;
        }

        .article-container,
        .article-grid {
            width: min(100% - 30px, 760px);
        }

        h1 {
            font-size: 44px;
            letter-spacing: -1px;
        }

        .hero-intro {
            font-size: 17px;
        }

        .hero-image img {
            height: 300px;
        }

        .article {
            padding: 60px 0;
        }

        .article-grid {
            display: block;
        }

        .article-side {
            position: static;
            margin-bottom: 35px;
        }

        .article-content h2 {
            font-size: 32px;
        }

        .article-content p,
        .article-content li {
            font-size: 16px;
        }

        .answer {
            padding: 25px;
        }

        .number-section {
            grid-template-columns: 45px 1fr;
            gap: 15px;
        }

        .article-image img {
            height: 280px;
        }

        .icon-section {
            padding: 35px 25px;
        }

        .table > div {
            grid-template-columns: 1fr;
            gap: 6px;
        }
    }
</style>
